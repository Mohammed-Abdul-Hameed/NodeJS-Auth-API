{
	"env": {
		"node": true,
		"es2021": true
	},
	"extends": ["eslint:recommended"],
	"parserOptions": {
		"ecmaVersion": "latest"
	},
	"rules": {
		"no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
		"no-console": "off",
		"prefer/const": "error",
		"eqeqeq": ["error", "always"],
		"curly": ["error", "all"]
	}
}
